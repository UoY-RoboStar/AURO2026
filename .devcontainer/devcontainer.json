// Use this devcontainer.json to develop within a standard Docker environment,
// with VNC providing the GUI support.
// It uses the prebuilt image from the GitHub Container Registry,
// so does not require a Dockerfile.
//
// This is the default configuration: it needs no host-side GPU/X11 detection
// (VNC's desktop and X server run inside the container, exposed over
// http://localhost:6080/), so unlike the wsl/ and other/ configurations it
// works unmodified under "Dev Containers: Clone Repository in Container
// Volume" as well as a normal local clone. See NOTES.md for why the other
// configurations can't be auto-selected and must be picked by hand.
{
  "name": "auro-vnc",
  "image": "ghcr.io/uoy-robostar/ros2-lyrical-tb3/auro-dev:latest",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/auro,type=bind",
  "workspaceFolder": "/workspaces/auro",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE},target=/home/ubuntu/homedir,type=bind,bind-propagation=rslave"
  ],
  "remoteUser": "ubuntu",
  "portsAttributes": {
      "6080": {
          "label": "Desktop"
      }
  },
  "postStartCommand": "touch /workspaces/.bash_history && ln -sf /workspaces/.bash_history /home/ubuntu/.bash_history ; /workspaces/${localWorkspaceFolderBasename}/.devcontainer/gitconfig.sh",
  "remoteEnv": {
    "USERNAME": "${localEnv:USERNAME}",
    "USERDNSDOMAIN": "${localEnv:USERDNSDOMAIN}",
    "LMODULES": "${localEnv:LOADEDMODULES}"
  },
  "containerEnv": {
    "VNC_RESOLUTION": "1280x720x24",
    "GZ_PARTITION": "bridge",
    "GZ_IP": "127.0.0.1"
  }
}
