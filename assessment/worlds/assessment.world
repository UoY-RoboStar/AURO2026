<?xml version='1.0' encoding='ASCII'?>
<sdf version='1.7'>
  <world name='world_demo'>
    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <max_contacts>10</max_contacts>
    </physics>
    
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

<gui fullscreen="false">
    <!-- 3D scene -->
    <plugin filename="MinimalScene" name="3D View">
      <gz-gui>
        <title>3D View</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="string" key="state">docked</property>
      </gz-gui>

      <engine>ogre2</engine>
      <scene>scene</scene>
      <ambient_light>0.4 0.4 0.4</ambient_light>
      <background_color>0.7 0.8 0.9</background_color>
      <!-- Diagonal view from high above the south-east, looking north-west, framing both pools (fuel/control
           cells on the left, storage cells on the right) and the charger at the west wall -->
      <camera_pose>8.336 -4.912 39.474 0 1.2654 2.6180</camera_pose>
    </plugin>

    <!-- Plugins that add functionality to the scene -->
    <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
      <gz-gui>
        <property key="state" type="string">floating</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="showTitleBar" type="bool">false</property>
      </gz-gui>
    </plugin>
    <plugin filename="GzSceneManager" name="Scene Manager">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </gz-gui>
    </plugin>
    <plugin filename="InteractiveViewControl" name="Interactive view control">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </gz-gui>
    </plugin>
    <plugin filename="CameraTracking" name="Camera Tracking">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </gz-gui>
    </plugin>
    <plugin filename="MarkerManager" name="Marker manager">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </gz-gui>
    </plugin>
    <!-- Cable from the winch block to the winch (WinchCable, in package auro_gz_plugins); winch_cable:=false removes it -->
    <plugin filename="WinchCable" name="Winch cable">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </gz-gui>
    </plugin>
    <plugin filename="SelectEntities" name="Select Entities">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </gz-gui>
    </plugin>

    <plugin filename="Spawn" name="Spawn Entities">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </gz-gui>
    </plugin>

    <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </gz-gui>
    </plugin>

    <!-- World control -->
    <plugin filename="WorldControl" name="World control">
      <gz-gui>
        <title>World control</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="bool" key="resizable">false</property>
        <property type="double" key="height">72</property>
        <property type="double" key="z">1</property>

        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="left" target="left"/>
          <line own="bottom" target="bottom"/>
        </anchors>
      </gz-gui>

      <play_pause>true</play_pause>
      <step>true</step>
      <start_paused>true</start_paused>
      <use_event>true</use_event>

    </plugin>

    <!-- World statistics -->
    <plugin filename="WorldStats" name="World stats">
      <gz-gui>
        <title>World stats</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="bool" key="resizable">false</property>
        <property type="double" key="height">110</property>
        <property type="double" key="width">290</property>
        <property type="double" key="z">1</property>

        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="right" target="right"/>
          <line own="bottom" target="bottom"/>
        </anchors>
      </gz-gui>

      <sim_time>true</sim_time>
      <real_time>true</real_time>
      <real_time_factor>true</real_time_factor>
      <iterations>true</iterations>
    </plugin>

    <!-- Insert simple shapes -->
    <plugin filename="Shapes" name="Shapes">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="x" type="double">0</property>
        <property key="y" type="double">0</property>
        <property key="width" type="double">300</property>
        <property key="height" type="double">50</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
        <property key="cardBackground" type="string">#666666</property>
      </gz-gui>
    </plugin>

    <!-- Insert lights -->
    <plugin filename="Lights" name="Lights">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="x" type="double">300</property>
        <property key="y" type="double">0</property>
        <property key="width" type="double">150</property>
        <property key="height" type="double">50</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
        <property key="cardBackground" type="string">#666666</property>
      </gz-gui>
    </plugin>

    <!-- Translate / rotate -->
    <plugin filename="TransformControl" name="Transform control">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="x" type="double">0</property>
        <property key="y" type="double">50</property>
        <property key="width" type="double">250</property>
        <property key="height" type="double">50</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
        <property key="cardBackground" type="string">#777777</property>
      </gz-gui>
    </plugin>

    <!-- Screenshot -->
    <plugin filename="Screenshot" name="Screenshot">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="x" type="double">250</property>
        <property key="y" type="double">50</property>
        <property key="width" type="double">50</property>
        <property key="height" type="double">50</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
        <property key="cardBackground" type="string">#777777</property>
      </gz-gui>
    </plugin>

    <!-- Copy/Paste -->
    <plugin filename="CopyPaste" name="CopyPaste">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="x" type="double">300</property>
        <property key="y" type="double">50</property>
        <property key="width" type="double">100</property>
        <property key="height" type="double">50</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
        <property key="cardBackground" type="string">#777777</property>
      </gz-gui>
    </plugin>

    <!-- Inspector -->
    <plugin filename="ComponentInspector" name="Component inspector">
      <gz-gui>
        <property type="bool" key="showTitleBar">false</property>
        <property type="string" key="state">docked</property>
      </gz-gui>
    </plugin>

    <!-- Entity tree -->

    <plugin filename="EntityTree" name="Entity tree">
      <gz-gui>
        <property type="bool" key="showTitleBar">false</property>
        <property type="string" key="state">docked</property>
      </gz-gui>
    </plugin>
    </gui>


    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 40 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>1 1 1 1</specular>
      <direction>0 0 -1</direction>
    </light>

<!-- Crane: three fixed xbeam rails at the top of the building (y = -3, 0 and +3 m, z 4.5..5 m, resting on
         the 5 m walls) and a beam bridging them, perpendicular to both and hanging 1 cm below them.
         The bridge rides on a prismatic joint on the middle rail, under position control, and carries a winch block that runs along it with a winch that drops into the pool; its travel (+-14.3 m) covers the rails' whole
         length, stopping where the bridge would meet the east and west walls. -->
    <model name="crane">
      <static>false</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="rail_south">
        <pose>0 -3 4.75 0 0 0</pose>
        <inertial>
          <mass>2000</mass>
          <inertia>
            <ixx>83.3333</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>145083</iyy><iyz>0</iyz>
            <izz>145083</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 -4.75 0 0 0</pose>
          <geometry><mesh><uri>package://assessment/worlds/meshes/xbeam.dae</uri><scale>0.5 0.5 0.5</scale></mesh></geometry>
        </visual>
        <collision name="collision">
          <geometry><box><size>29.5 0.5 0.5</size></box></geometry>
        </collision>
      </link>
      <link name="rail_north">
        <pose>0 3 4.75 0 0 0</pose>
        <inertial>
          <mass>2000</mass>
          <inertia>
            <ixx>83.3333</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>145083</iyy><iyz>0</iyz>
            <izz>145083</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 -4.75 0 0 0</pose>
          <geometry><mesh><uri>package://assessment/worlds/meshes/xbeam.dae</uri><scale>0.5 0.5 0.5</scale></mesh></geometry>
        </visual>
        <collision name="collision">
          <geometry><box><size>29.5 0.5 0.5</size></box></geometry>
        </collision>
      </link>
      <link name="bridge">
        <pose>0 0 4.24 0 0 0</pose>
        <inertial>
          <mass>500</mass>
          <inertia>
            <ixx>2052.08</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>20.8333</iyy><iyz>0</iyz>
            <izz>2052.08</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 -4.24 0 0 0</pose>
          <geometry><mesh><uri>package://assessment/worlds/meshes/beam.dae</uri><scale>0.5 0.5 0.5</scale></mesh></geometry>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.5 7 0.5</size></box></geometry>
        </collision>
      </link>
      <link name="rail_middle">
        <pose>0 0 4.75 0 0 0</pose>
        <inertial>
          <mass>2000</mass>
          <inertia>
            <ixx>83.3333</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>145083</iyy><iyz>0</iyz>
            <izz>145083</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 -4.75 0 0 0</pose>
          <geometry><mesh><uri>package://assessment/worlds/meshes/xbeam.dae</uri><scale>0.5 0.5 0.5</scale></mesh></geometry>
        </visual>
        <collision name="collision">
          <geometry><box><size>29.5 0.5 0.5</size></box></geometry>
        </collision>
      </link>
      <link name="winch_block">
        <pose>0 0 3.865 0 0 0</pose>
        <inertial>
          <mass>200</mass>
          <inertia>
            <ixx>5.20833</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>5.20833</iyy><iyz>0</iyz>
            <izz>8.33333</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 -3.52 0 0 0</pose>
          <geometry><mesh><uri>package://assessment/worlds/meshes/winch_block.dae</uri><scale>0.5 0.5 0.5</scale></mesh></geometry>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.25</size></box></geometry>
        </collision>
      </link>
      <link name="winch">
        <pose>0 0 3.615 0 0 0</pose>
        <inertial>
          <mass>100</mass>
          <inertia>
            <ixx>2.60417</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.60417</iyy><iyz>0</iyz>
            <izz>4.16667</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 -3.52 0 0 0</pose>
          <geometry><mesh><uri>package://assessment/worlds/meshes/winch.dae</uri><scale>0.5 0.5 0.5</scale></mesh></geometry>
          <!-- Only bit 0 set: hidden from winch_camera (mask 0x3FFFFFFE), visible to the GUI -->
          <visibility_flags>0x00000001</visibility_flags>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.25</size></box></geometry>
        </collision>
        <!-- Downward-looking camera at the top of the winch, centred; it moves with the hoist, and the
             image centre is the point directly below the winch. The winch visual is hidden from it
             (visibility_mask below vs. the winch's visibility_flags), so it sees through the winch, and
             a held rod (top ~0.25 m below the camera) appears as a square in the middle of the image.
             90 deg FOV: with the winch fully raised the rod tops (6.6 m below) fill about 13 x 10 m.
             Image orientation: up = +x (along bridge_slide), left = +y (along winch_block_slide).
             Topics: /crane/winch_camera/image and /crane/winch_camera/camera_info, frame_id
             crane/winch_camera_optical (published on TF by assessment.launch.py).
             update_rate is overridden by assessment.launch.py (winch_camera_rate:=..., default 10),
             which can also add Gaussian pixel noise (winch_camera_noise:=..., default 0). -->
        <sensor name="winch_camera" type="camera">
          <pose>0 0 0.12 0 1.5708 0</pose>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>/crane/winch_camera/image</topic>
          <frame_id>crane/winch_camera_optical</frame_id>
          <camera>
            <horizontal_fov>1.5708</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>50</far></clip>
            <!-- all bits except bit 0 (the winch); the top two bits are reserved by ogre2 -->
            <visibility_mask>0x3FFFFFFE</visibility_mask>
          </camera>
        </sensor>
      </link>
      
      <!-- the winch block hangs under the bridge and runs along it (y), its whole length -->
      <joint name="winch_block_slide" type="prismatic">
        <parent>bridge</parent>
        <child>winch_block</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-3.25</lower><upper>3.25</upper><effort>50000</effort><velocity>2</velocity></limit>
          <dynamics><damping>50</damping><friction>0</friction></dynamics>
        </axis>
      </joint>
      <!-- the winch drops from the block (0) to the top of the cells on the pool floor (-6.385 m) -->
      <joint name="winch_lift" type="prismatic">
        <parent>winch_block</parent>
        <child>winch</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-6.385</lower><upper>0</upper><effort>50000</effort><velocity>2</velocity></limit>
          <dynamics><damping>50</damping><friction>0</friction></dynamics>
        </axis>
      </joint>
      <!-- Grab/release objects with the winch (gz_link_attacher, in package auro_gz_plugins). Nothing is attached at start.
           Services (request gz.msgs.WorldControl, ignored; reply gz.msgs.Boolean, true = done), bridged
           to ROS as ros_gz_interfaces/srv/ControlWorld under the same names:
             /crane/winch/attach  attach the nearest non-static link within max_distance of the winch
             /crane/winch/detach  release it
           Failure reasons go to the Gazebo log. assessment.launch.py adds failure_probability
           (winch_failure_probability:=..., default 0) and random_seed: a valid attach or detach then
           fails with that probability, leaving things as they were and replying false.
           Which link is held is not published. Set publish_state to true to publish it as
           gz.msgs.StringMsg on state_topic ("detached" / "attached:model::link"), and uncomment the
           matching entry in config/bridge.yaml.
           max_distance is between link origins: winch resting on a rod = 1.075 m, the neighbouring
           rods (0.5 m away) = 1.19 m, so only the rod directly underneath can be grabbed. -->
      <plugin filename="gz_link_attacher" name="auro::LinkAttacher">
        <parent_link>winch</parent_link>
        <attach_service>/crane/winch/attach</attach_service>
        <detach_service>/crane/winch/detach</detach_service>
        <publish_state>false</publish_state>
        <state_topic>/crane/winch/state</state_topic>
        <max_distance>1.15</max_distance>
      </plugin>
      <!-- The winch's brake (gz_joint_brake, in package auro_gz_plugins), on from the start, as on
           a real hoist: while it is on, winch_lift does not move, whatever effort is applied to
           it, so the winch stays up until the controller holds it. Services (request
           gz.msgs.WorldControl, ignored; reply gz.msgs.Boolean, true once the brake is in that
           state), bridged to ROS as ros_gz_interfaces/srv/ControlWorld under the same names:
             /crane/winch/brake/release  take the brake off
             /crane/winch/brake/engage   put it on, holding the winch where it is -->
      <plugin filename="gz_joint_brake" name="auro::JointBrake">
        <joint_name>winch_lift</joint_name>
        <engaged>true</engaged>
        <engage_service>/crane/winch/brake/engage</engage_service>
        <release_service>/crane/winch/brake/release</release_service>
      </plugin>
      <!-- Crane joint positions as gz.msgs.Model on /crane/joint_states; bridged to ROS as
           sensor_msgs/JointState on the same topic (config/bridge.yaml) -->
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>/crane/joint_states</topic>
        <joint_name>bridge_slide</joint_name>
        <joint_name>winch_block_slide</joint_name>
        <joint_name>winch_lift</joint_name>
        <joint_name>rail_south_mount</joint_name>
        <joint_name>rail_north_mount</joint_name>
        <joint_name>rail_middle_mount</joint_name>
      </plugin>
      <!-- Rotating warning beacons on top of the bridge, clear of the rails and of the trolley's
           travel beneath it. Their beams lean out and down, and cast no shadows, so they reach the
           floor through the crane. Left out of the crane's URDF, and of task1, where the crane is
           static: see BEACON_PREFIX in tasks.py. -->
      <link name="beacon_south">
        <pose>0 -1.75 4.59 0 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.005</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.005</iyy><iyz>0</iyz>
            <izz>0.005</izz>
          </inertia>
        </inertial>
        <visual name="dome">
          <geometry><cylinder><radius>0.09</radius><length>0.2</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.05 0 1</ambient>
            <diffuse>1 0.5 0 1</diffuse>
            <emissive>1 0.5 0 1</emissive>
          </material>
        </visual>
        <visual name="reflector">
          <pose>0.08 0 0 0 0 0</pose>
          <geometry><box><size>0.03 0.12 0.16</size></box></geometry>
          <material>
            <diffuse>1 1 0.8 1</diffuse>
            <emissive>1 1 0.8 1</emissive>
          </material>
        </visual>
        <light name="lamp" type="spot">
          <pose>0 0 0 0 -0.785398 0</pose>
          <attenuation>
            <range>12</range>
            <linear>0</linear>
            <constant>0.1</constant>
            <quadratic>0.0025</quadratic>
          </attenuation>
          <diffuse>1 0.5 0 1</diffuse>
          <specular>1 0.5 0 1</specular>
          <spot>
            <inner_angle>0.5</inner_angle>
            <outer_angle>0.7</outer_angle>
            <falloff>2.0</falloff>
          </spot>
          <direction>0 0 -1</direction>
          <cast_shadows>false</cast_shadows>
          <visualize>false</visualize>
        </light>
      </link>
      <joint name="beacon_south_spin" type="revolute">
        <parent>bridge</parent>
        <child>beacon_south</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><effort>1000</effort><velocity>20</velocity></limit>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-controller-system"
              name="gz::sim::systems::JointController">
        <joint_name>beacon_south_spin</joint_name>
        <initial_velocity>6.0</initial_velocity>
      </plugin>
      <link name="beacon_north">
        <pose>0 1.75 4.59 0 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.005</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.005</iyy><iyz>0</iyz>
            <izz>0.005</izz>
          </inertia>
        </inertial>
        <visual name="dome">
          <geometry><cylinder><radius>0.09</radius><length>0.2</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.05 0 1</ambient>
            <diffuse>1 0.5 0 1</diffuse>
            <emissive>1 0.5 0 1</emissive>
          </material>
        </visual>
        <visual name="reflector">
          <pose>0.08 0 0 0 0 0</pose>
          <geometry><box><size>0.03 0.12 0.16</size></box></geometry>
          <material>
            <diffuse>1 1 0.8 1</diffuse>
            <emissive>1 1 0.8 1</emissive>
          </material>
        </visual>
        <light name="lamp" type="spot">
          <pose>0 0 0 0 -0.785398 0</pose>
          <attenuation>
            <range>12</range>
            <linear>0</linear>
            <constant>0.1</constant>
            <quadratic>0.0025</quadratic>
          </attenuation>
          <diffuse>1 0.5 0 1</diffuse>
          <specular>1 0.5 0 1</specular>
          <spot>
            <inner_angle>0.5</inner_angle>
            <outer_angle>0.7</outer_angle>
            <falloff>2.0</falloff>
          </spot>
          <direction>0 0 -1</direction>
          <cast_shadows>false</cast_shadows>
          <visualize>false</visualize>
        </light>
      </link>
      <joint name="beacon_north_spin" type="revolute">
        <parent>bridge</parent>
        <child>beacon_north</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><effort>1000</effort><velocity>20</velocity></limit>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-controller-system"
              name="gz::sim::systems::JointController">
        <joint_name>beacon_north_spin</joint_name>
        <initial_velocity>6.0</initial_velocity>
      </plugin>
      <joint name="rail_south_mount" type="fixed">
        <parent>world</parent>
        <child>rail_south</child>
      </joint>
      <joint name="rail_north_mount" type="fixed">
        <parent>world</parent>
        <child>rail_north</child>
      </joint>
      <joint name="rail_middle_mount" type="fixed">
        <parent>world</parent>
        <child>rail_middle</child>
      </joint>
      <!-- Linear (prismatic) joint carrying the bridge along the middle rail, parallel to x -->
      <joint name="bridge_slide" type="prismatic">
        <parent>rail_middle</parent>
        <child>bridge</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit><lower>-14.3</lower><upper>14.3</upper><effort>100000</effort><velocity>2</velocity></limit>
          <dynamics><damping>100</damping><friction>0</friction></dynamics>
        </axis>
      </joint>
      <!-- ros2_control of the crane's three joints (gz_ros2_control): a controller manager,
           /crane/controller_manager, with effort_controller, a
           forward_command_controller/ForwardCommandController that applies the efforts sent on
           /crane/effort_controller/commands to bridge_slide, winch_block_slide and winch_lift (see
           config/crane_controllers.yaml). assessment.launch.py sets <parameters> to that file's
           path, publishes the URDF the controller manager needs on /crane/control_description
           (the crane's /crane/robot_description is its SDF, for RViz), and loads the controller.
           Removed in task1, with every other plugin of the crane. -->
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>crane_controllers.yaml</parameters>
        <controller_manager_name>controller_manager</controller_manager_name>
        <ros>
          <namespace>crane</namespace>
          <remapping>robot_description:=control_description</remapping>
        </ros>
      </plugin>
    </model>


    <!-- Tugbot charging station (MovAi, Gazebo Fuel), full size, standing on the floor against the
      middle of the west wall. Yaw = pi turns its back to the wall so the docking side faces east,
      into the building. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/Tugbot-charging-station</uri>
      <name>charging_station</name>
      <pose>-14.5 0 0.1 0 0 3.14159265</pose>
      <static>true</static>
    </include>

    <!-- Carts -->

    <include>
      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/cart_model_2
      </uri>
      <name>cart1</name>
      <pose>-5.73 15 0.25 0 -0 0</pose>
    </include>

    <!-- 29.5 x 25.4 m concrete floor slab, 0.1 m thick, top at z = 0.1 m,
         with a 19.5 x 6 m opening in the middle (where the pool block sits) -->
    <model name="floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>package://assessment/worlds/meshes/floor.dae</uri>
              <scale>0.5 0.5 0.5</scale>
            </mesh>
          </geometry>
        </visual>

        <!-- Collision as four boxes around the opening: exact for this shape and more robust than mesh collision -->
        <collision name="strip_south">
          <pose>0 -7.85 0.05 0 0 0</pose>
          <geometry><box><size>29.5 9.7 0.1</size></box></geometry>
        </collision>
        <collision name="strip_north">
          <pose>0 7.85 0.05 0 0 0</pose>
          <geometry><box><size>29.5 9.7 0.1</size></box></geometry>
        </collision>
        <collision name="strip_west">
          <pose>-12.25 0 0.05 0 0 0</pose>
          <geometry><box><size>5 6 0.1</size></box></geometry>
        </collision>
        <collision name="strip_east">
          <pose>12.25 0 0.05 0 0 0</pose>
          <geometry><box><size>5 6 0.1</size></box></geometry>
        </collision>
      </link>
    </model>

   <!-- Brick walls: 29.5 x 25.4 m outside, 0.2 m thick, 5 m tall, standing on z = 0 -->
    <model name="walls">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>package://assessment/worlds/meshes/walls.dae</uri>
              <scale>0.5 0.5 0.5</scale>
            </mesh>
          </geometry>
        </visual>

        <!-- Collision as four boxes, one per wall: exact for this shape and more robust than mesh collision -->
        <collision name="wall_south">
          <pose>0 -12.6 2.5 0 0 0</pose>
          <geometry><box><size>29.5 0.2 5</size></box></geometry>
        </collision>
        <collision name="wall_north">
          <pose>0 12.6 2.5 0 0 0</pose>
          <geometry><box><size>29.5 0.2 5</size></box></geometry>
        </collision>
        <collision name="wall_west">
          <pose>-14.65 0 2.5 0 0 0</pose>
          <geometry><box><size>0.2 25 5</size></box></geometry>
        </collision>
        <collision name="wall_east">
          <pose>14.65 0 2.5 0 0 0</pose>
          <geometry><box><size>0.2 25 5</size></box></geometry>
        </collision>
      </link>
    </model>
    
    <!-- Tiled pool block: 19.5 x 6 m, rim at z = 0.11 m.
         Two 6.5 x 4.5 m pools, 5.005 m deep, joined by a 5 x 1.5 m channel, 2.99 m deep. -->
    <model name="pool">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>package://assessment/worlds/meshes/pool.dae</uri>
              <scale>0.5 0.5 0.5</scale>
            </mesh>
          </geometry>
          <!-- PBR material (replaces the simpler material stored in the .dae) -->
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>1 1 1 1</specular>
            <pbr>
              <metal>
                <albedo_map>package://assessment/worlds/meshes/Poliigon_TilesCeramicWhite_6956_BaseColor.jpg</albedo_map>
                <normal_map type="tangent">package://assessment/worlds/meshes/Poliigon_TilesCeramicWhite_6956_Normal.png</normal_map>
                <roughness_map>package://assessment/worlds/meshes/Poliigon_TilesCeramicWhite_6956_Roughness.jpg</roughness_map>
                <roughness>1.0</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>

        <!-- Water surface: visual only. The parts over the dividers sit inside the solid block, so they stay
             hidden. Only bit 0 set: hidden from winch_camera (mask 0x3FFFFFFE), but visible to the GUI and
             to cameras with the default mask, such as the robots'. A thin box, not a plane: its bottom
             face shows the surface from below, from within the pool, which a plane's does not, even
             with double_sided set; from above, only its top face is drawn -->
        <visual name="water_surface">
          <pose>0 0 -0.1 0 0 0</pose>
          <geometry><box><size>18 4.5 0.002</size></box></geometry>
          <material>
            <ambient>0.1 0.4 0.6 1</ambient>
            <diffuse>0.1 0.4 0.6 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
          <transparency>0.6</transparency>
          <cast_shadows>false</cast_shadows>
          <visibility_flags>0x00000001</visibility_flags>
        </visual>

        <!-- Collision as eight boxes that exactly fill the solid block around the pools and channel -->
        <collision name="base">
          <pose>0 0 -4.9925 0 0 0</pose>
          <geometry><box><size>19.5 6 0.195</size></box></geometry>
        </collision>
        <collision name="side_south">
          <pose>0 -2.625 -2.3925 0 0 0</pose>
          <geometry><box><size>19.5 0.75 5.005</size></box></geometry>
        </collision>
        <collision name="side_north">
          <pose>0 2.625 -2.3925 0 0 0</pose>
          <geometry><box><size>19.5 0.75 5.005</size></box></geometry>
        </collision>
        <collision name="end_west">
          <pose>-9.375 0 -2.3925 0 0 0</pose>
          <geometry><box><size>0.75 4.5 5.005</size></box></geometry>
        </collision>
        <collision name="end_east">
          <pose>9.375 0 -2.3925 0 0 0</pose>
          <geometry><box><size>0.75 4.5 5.005</size></box></geometry>
        </collision>
        <collision name="divider_south">
          <pose>0 -1.5 -2.3925 0 0 0</pose>
          <geometry><box><size>5 1.5 5.005</size></box></geometry>
        </collision>
        <collision name="divider_north">
          <pose>0 1.5 -2.3925 0 0 0</pose>
          <geometry><box><size>5 1.5 5.005</size></box></geometry>
        </collision>
        <collision name="under_canal">
          <pose>0 0 -3.8875 0 0 0</pose>
          <geometry><box><size>5 1.5 2.015</size></box></geometry>
        </collision>
      </link>
    </model>

