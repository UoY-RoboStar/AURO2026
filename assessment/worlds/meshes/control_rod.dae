    <source id="control_rod-pos"><float_array id="control_rod-pos-arr" count="24">-0.39 0.39 4.1 0.39 -0.39 4.1 0.39 0.39 4.1 -0.39 -0.39 4.1 -0.39 -0.39 0.3 0.39 0.39 0.3 0.39 -0.39 0.3 -0.39 0.39 0.3</float_array><technique_common><accessor source="#control_rod-pos-arr" count="8" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common></source>
