    <unit name="meter" meter="1"/><up_axis>Z_UP</up_axis></asset>
  <library_images>
    <image id="base-img" name="base-img"><init_from>Poliigon_TilesCeramicWhite_6956_BaseColor.jpg</init_from></image>
    <image id="normal-img" name="normal-img"><init_from>Poliigon_TilesCeramicWhite_6956_Normal.png</init_from></image>
    <image id="rough-img" name="rough-img"><init_from>Poliigon_TilesCeramicWhite_6956_Roughness.jpg</init_from></image>
  </library_images>
  <library_effects><effect id="tiles-fx"><profile_COMMON>
    <newparam sid="base-surface"><surface type="2D"><init_from>base-img</init_from></surface></newparam><newparam sid="base-sampler"><sampler2D><source>base-surface</source><wrap_s>WRAP</wrap_s><wrap_t>WRAP</wrap_t><minfilter>LINEAR_MIPMAP_LINEAR</minfilter><magfilter>LINEAR</magfilter></sampler2D></newparam><newparam sid="normal-surface"><surface type="2D"><init_from>normal-img</init_from></surface></newparam><newparam sid="normal-sampler"><sampler2D><source>normal-surface</source><wrap_s>WRAP</wrap_s><wrap_t>WRAP</wrap_t><minfilter>LINEAR_MIPMAP_LINEAR</minfilter><magfilter>LINEAR</magfilter></sampler2D></newparam><newparam sid="rough-surface"><surface type="2D"><init_from>rough-img</init_from></surface></newparam><newparam sid="rough-sampler"><sampler2D><source>rough-surface</source><wrap_s>WRAP</wrap_s><wrap_t>WRAP</wrap_t><minfilter>LINEAR_MIPMAP_LINEAR</minfilter><magfilter>LINEAR</magfilter></sampler2D></newparam>
    <technique sid="common"><blinn>
      <diffuse><texture texture="base-sampler" texcoord="UVMap"/></diffuse>
      <specular><color sid="specular">0.5 0.5 0.5 1</color></specular>
      <shininess><float sid="shininess">80</float></shininess>
      <index_of_refraction><float sid="ior">1.5</float></index_of_refraction>
    </blinn>
    <extra>
      <technique profile="FCOLLADA"><bump><texture texture="normal-sampler" texcoord="UVMap"/></bump></technique>
      <technique profile="OpenCOLLADA3dsMax"><bump bumptype="NORMALMAP"><texture texture="normal-sampler" texcoord="UVMap"/></bump></technique>
    </extra></technique>
  </profile_COMMON></effect></library_effects>
  <library_materials><material id="tiles-mat" name="TilesCeramicWhite"><instance_effect url="#tiles-fx"/></material></library_materials>
