
interface IOperations {
	cmd_vel (   msg : TwistStamped )
}

interface IEvents {
	event scan : Seq( real )
}

robotic platform TurtleBot {
	uses IEvents 
	provides IOperations 
}

type Header

datatype Twist { 
	linear : Vector3 
	angular : Vector3
} 

datatype TwistStamped { 
	header : Header
	twist : Twist
}

datatype Vector3 { 
	x : real 
	y : real 
	z : real
}